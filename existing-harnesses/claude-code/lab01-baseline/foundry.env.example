# Non-secret Foundry settings. Source a private edited copy outside the repository.
export CLAUDE_CODE_USE_FOUNDRY=1
export ANTHROPIC_FOUNDRY_RESOURCE=YOUR_RESOURCE
# If deployment names differ from defaults, set the appropriate
# ANTHROPIC_DEFAULT_SONNET_MODEL / ANTHROPIC_DEFAULT_HAIKU_MODEL /
# ANTHROPIC_DEFAULT_OPUS_MODEL to your deployment name.
# Use az login for Entra, or supply ANTHROPIC_FOUNDRY_API_KEY
# from a secret manager instead. Never store credentials here.
